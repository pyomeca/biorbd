# Include required files
include LICENSE
include pyproject.toml
include README.md

# Include shared libraries or compiled files (if needed for runtime).
recursive-include biorbd *.so *.dll *.dylib *.pyd *.lib *.py

# Exclude development files (CMakeLists.txt and *.cmake.in are needed to build from the sdist)
prune .github
prune external
prune _skbuild

# Exclude docs, tests and example data
prune doc
prune test
prune examples

# Exclude version control and temporary files
global-exclude *.git*
global-exclude __pycache__/*
global-exclude *.py[co]

include build_backend/biorbd_build_backend.py
